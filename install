#!/bin/bash

# shellcheck disable=1091
source AliasesAndFunctions/default/functions

repoLocation="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

echo "Linking bashrc..."
ln -sf "${repoLocation}/Configurations/bashrc" "${HOME}/.bashrc"

if ! crontab -l 2>/dev/null | grep -q "cd ${repoLocation} && git pull"; then
	echo "Installing crontab to update the repository regularly..."
	(
		crontab -l 2>/dev/null
		echo "0 */3 * * * cd ${repoLocation} && git pull"
	) | crontab -
else
	echo "Crontab already exists, skipping..."
fi

if ! command -v lazygit >/dev/null 2>&1; then
	echo -e "\nInstalling lazygit..."
	install_lazygit
fi

git_prompt_file="${HOME}/.git-prompt.sh"
if [[ ! -f "${git_prompt_file}" ]]; then
	echo "The git prompt is not installed, downloading..."
	wget -O "${git_prompt_file}" https://raw.githubusercontent.com/git/git/master/contrib/completion/git-prompt.sh
fi

echo "Linking configuration files..."
if command -v git >/dev/null 2>&1; then
	echo "Linking gitconfig..."
	ln -sf "${repoLocation}/Configurations/gitconfig" "${HOME}/.gitconfig"
fi
if command -v lazygit >/dev/null 2>&1; then
	echo "Linking lazygit configuration..."
	if is_mac_os; then
		ln -sf "${repoLocation}/Configurations/lazygit.yml" "${HOME}/Library/Application Support/lazygit/config.yml"
	else
		mkdir -p "${HOME}/.config/lazygit/"
		ln -sf "${repoLocation}/Configurations/lazygit.yml" "${HOME}/.config/lazygit/config.yml"
	fi
fi
if is_mac_os && command -v podman >/dev/null 2>&1; then
	echo "Linking podman machine autostart LaunchAgent..."
	mkdir -p "${HOME}/Library/LaunchAgents"
	launchAgent="${HOME}/Library/LaunchAgents/com.podman.machine-default.plist"
	ln -sf "${repoLocation}/Configurations/com.podman.machine-default.plist" "${launchAgent}"
	launchctl bootout "gui/$(id -u)/com.podman.machine-default" 2>/dev/null
	launchctl bootstrap "gui/$(id -u)" "${launchAgent}"
fi
if command -v claude >/dev/null 2>&1; then
	echo "Linking claude configuration..."
	mkdir -p "${HOME}/.claude"
	ln -sf "${repoLocation}/Configurations/claude.json" "${HOME}/.claude/settings.json"
	ln -sf "${repoLocation}/Configurations/claude.md" "${HOME}/.claude/CLAUDE.md"
fi


if [[ -d "${HOME}/repos" ]]; then
	echo "Linking forbid AI git commit hook into all repositories below ${HOME}/repos..."
	hookSource="${repoLocation}/Configurations/forbid_ai_commit_git_hook"
	while IFS= read -r -d '' gitPath; do
		repository="$(dirname "${gitPath}")"

		hooksDirectory="$(git -C "${repository}" rev-parse --git-path hooks)" || continue
		[[ ${hooksDirectory} == /* ]] || hooksDirectory="${repository}/${hooksDirectory}"
		hookTarget="${hooksDirectory}/commit-msg"

		# pre-commit owns commit-msg where it is installed, but runs commit-msg.legacy first and fails the commit if that hook fails
		if grep -qs "generated by pre-commit" "${hookTarget}"; then
			hookTarget="${hookTarget}.legacy"
		fi

		if [[ -e ${hookTarget} || -L ${hookTarget} ]]; then
			continue
		fi

		echo " - ${repository}"
		mkdir -p "${hooksDirectory}"
		ln -s "${hookSource}" "${hookTarget}"
	done < <(find "${HOME}/repos" -name .venv -prune -o -name .git -print0)
else
	echo "No \"${HOME}/repos\" directory found, skipping git hooks..."
fi

if is_mac_os; then
	echo "Remember to set the iTerm settings folder to \"${repoLocation}/Configurations/\""
	echo "Remember to import the AltTab settings from \"${repoLocation}/Configurations/alt-tab.plist\""
	echo "Remember to import the Rectangle settings from \"${repoLocation}/Configurations/Rectangle.json\""
fi

echo "Remember to import the KeePassXC settings from \"${repoLocation}/Configurations/KeePassXC.ini\""

if [[ $(cat /proc/version 2>/dev/null) =~ (M|m)icrosoft ]]; then
	if [[ ! -f /etc/sudoers.d/sudoers_no_password ]]; then
		echo -n "WSL detected, do you want to install the sudoers configuration that allows the usage of no password for elevated commands? [Y/N] "
		read -r -n 1 answer
		if [[ $answer =~ ^[Yy]$ ]]; then
			echo -e "\nInstalling sudoers configuration..."
			# No linking possible since the config file has to broad permissions
			sudo cp "${repoLocation}/Configurations/sudoers_no_password" "/etc/sudoers.d/"
		else
			echo -e "\nSkipping sudoers configuration..."
		fi
	else
		echo "WSL detected, but sudoers configuration is already present"
	fi
fi

echo "Finished 🎉"
exit 0
